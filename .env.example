# Gujarat e-Vidya Scholarship Portal - Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL for Docker/Production, SQLite fallback for local developer testing)
# DATABASE_URL=postgresql://evidya_user:evidya_secure_password_2026@localhost:5432/evidya_db
DATABASE_URL=sqlite:///./gujarat_evidya.db

# Redis Atomic Locking & Cache (Falls back to thread-safe in-memory cache if offline)
REDIS_URL=redis://localhost:6379/0

# JWT Auth & Security
JWT_SECRET_KEY=gujarat-evidya-secure-architectural-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AWS S3 Document Storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=gujarat-evidya-income-certificates
AWS_ACCESS_KEY_ID=MOCK_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=MOCK_AWS_SECRET_ACCESS_KEY
S3_MOCK_MODE=true
S3_PRESIGNED_EXPIRATION_SECONDS=300

# Central UDISE+ / DigiLocker Gateway
UDISE_MOCK_BASE_URL=https://api.udiseplus.gov.in/mock
UDISE_CLIENT_ID=gj_state_portal_client
UDISE_CLIENT_SECRET=gj_secret_credential_token
UDISE_TIMEOUT_SECONDS=2.0
UDISE_CIRCUIT_FAILURE_THRESHOLD=3
UDISE_CIRCUIT_RECOVERY_TIMEOUT=10.0
